{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "Provider": "Pin",
    "Pin": {
      "MaxFailedAttempts": 5,
      "LockoutDuration": "00:01:00",
      "IdleTimeout": "00:15:00"
    }
  },
  "DemoLogging": {
    "DirectoryPath": "logs",
    "FileSizeLimitBytes": 10485760,
    "RetainedFileCountLimit": 10
  }
}
